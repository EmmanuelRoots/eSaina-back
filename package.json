{
  "name": "esaina_back",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "nodemon -e ts --watch './src/**/*.ts' --watch './prisma/seed/**/*.ts' --ignore './src/api/routes/routes.ts' --exec \"npx yarn update-docs && yarn seed && ts-node ./src/index.ts\"",
    "build": "tsc && tsoa spec-and-routes",
    "start": "node dist/server.js",
    "update-docs": "tsoa spec-and-routes",
    "studio": "prisma studio",
    "migrate": "node -e \"const readlineSync = require('readline-sync'); const migrationName = readlineSync.question('Nom de la migration sans espace : '); if (!migrationName) { console.error('Veuillez fournir un nom de migration valide.'); process.exit(1); } require('child_process').execSync('npx prisma migrate dev --name ' + migrationName, { stdio: 'inherit' });\"",
    "seed": "npx prisma db seed",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "prisma": {
    "seed": "ts-node prisma/seed/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.16.2",
    "readline-sync": "^1.4.10",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.6.0",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.10",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
